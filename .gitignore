# scaffold leftovers
.cta.json
__unconfig*
todos.json

# A literal `@` directory, not the path alias. `shadcn add` sometimes writes a
# registry dependency to the raw alias string instead of resolving it,
# producing ./@/components/ui/*.tsx - byte-identical duplicates that nothing
# imports, because every tool maps `@` before the filesystem is consulted.
# Harmless until committed and someone edits the wrong copy.
/@/

# Local project context and verification reports
/.agents/skills/devin-project-context/
/.devin-project-harness/
