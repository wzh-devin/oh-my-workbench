# editors and OS. `._*` is the macOS AppleDouble sidecar, written whenever this
# tree is copied to a non-HFS volume: a USB stick, a network share, a zip.
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
