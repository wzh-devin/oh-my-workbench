# Copy to .env.local at the repository root; process environment variables take precedence.
# Keep secrets local and never prefix them with VITE_.

# Go API
WORKER_ID=1
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:5432/workbench?sslmode=disable&search_path=public
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

HTTP_ADDR=localhost:11990
# Set true behind HTTPS in production.
COOKIE_SECURE=false


# Shared gateway for Office previews and thumbnails; use an address reachable by the API.
ASSET_CONVERTER_URL=http://127.0.0.1:13039

# Generate once from apps/api with: go run ./cmd/mailkeys
# Keep these stable across restarts and identical on every API instance.
MAIL_ENCRYPTION_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# ReUI license key - only needed when installing premium components.
# Get a key: https://reui.io/pricing
# Setup docs: https://reui.io/docs/license-setup
REUI_LICENSE_KEY=
