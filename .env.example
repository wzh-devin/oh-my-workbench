# Copy to .env.local at the repository root; process environment variables take precedence.
# Keep secrets local and never prefix them with VITE_.
# Docker Compose: pass --env-file .env.local and use addresses reachable from the container.

# Required deployment connections.
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:5432/workbench?sslmode=disable&search_path=public
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Set true behind HTTPS in production.
COOKIE_SECURE=false

# Optional: defaults to 1; use a distinct 0-1023 ID for every API instance.
# WORKER_ID=1
