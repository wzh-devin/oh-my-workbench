# Copy this file to `apps/web/.env.local` and fill in your key:
#   cp .env.example apps/web/.env.local
#
# ReUI license key - required only to INSTALL premium blocks and Motion Icons.
# The shadcn CLI sends it as `Authorization: Bearer`, per the @reui registry
# entry in apps/web/components.json. Free ReUI components and the c-* examples install
# without a key, and so does everything already vendored into this repo.
#
# It is read at INSTALL time only. The application reads no secrets at runtime, so a production build needs no environment at
# all. `.env.local` is gitignored and must never be committed.
#
# Get a key: https://reui.io/pricing
# Setup docs: https://reui.io/docs/license-setup
REUI_LICENSE_KEY=
