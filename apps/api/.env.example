# Copy to .env; existing process environment variables take precedence.
WORKER_ID=1
DATABASE_URL=postgres://workbench:workbench@127.0.0.1:5432/workbench?sslmode=disable&search_path=public
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

HTTP_ADDR=localhost:11990
# Set true behind HTTPS in production.
COOKIE_SECURE=false

# Generate once with: go run ./cmd/mailkeys
# Keep these stable across restarts and identical on every API instance.
MAIL_ENCRYPTION_KEY=
# Optional SOCKS5 transport for all IMAP operations; empty means direct.
# MAIL_PROXY_URL=socks5h://127.0.0.1:7890
MAIL_PROXY_URL=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com
